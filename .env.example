# Exemple uniquement - ne placer aucun secret réel dans ce fichier.
REZO_DB_HOST=localhost
REZO_DB_PORT=5432
REZO_DB_NAME=rezo
REZO_DB_USERNAME=rezo_app
REZO_DB_PASSWORD=replace_with_a_local_password

# Générer une valeur aléatoire longue pour chaque environnement.
REZO_JWT_SECRET=replace_with_at_least_32_random_characters
REZO_JWT_EXPIRATION_MS=900000
REZO_JWT_REFRESH_EXPIRATION_MS=604800000

REZO_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REZO_UPLOAD_DIR=./uploads

